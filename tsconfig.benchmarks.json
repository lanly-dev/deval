{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "rootDir": ".",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "types": [
            "node"
        ]
    },
    "include": [
        "benchmarks/**/*.ts",
        "resources/**/*.ts",
        "vitest.config.mts",
        "src/agent/loop.ts",
        "src/agent/tool-schemas.ts",
        "src/events/event-log.ts",
        "src/events/score-trajectory.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "out"
    ]
}
